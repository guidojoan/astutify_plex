[Unit]
Description=Bluetooth HID Mouse Jiggler daemon
After=bluetooth.target dbus.service
Requires=bluetooth.target

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/venv/bin/python -m daemon.jiggler_daemon
User=root
Group=mousejiggler
RuntimeDirectory=mouse-jiggler
RuntimeDirectoryMode=0770
StateDirectory=mouse-jiggler
StateDirectoryMode=0770
Environment=MOUSE_JIGGLER_SOCKET=/run/mouse-jiggler/daemon.sock
Environment=MOUSE_JIGGLER_CONFIG=/var/lib/mouse-jiggler/config.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
